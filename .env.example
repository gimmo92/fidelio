# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Prisma — usa il POOLER (Connect → Transaction), NON db.xxx:6543
# user = postgres.PROJECT_REF · region = es. eu-central-1
# Se la password ha ! @ # → URL-encode (%21 %40 %23)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Session pooler (porta 5432) per migrazioni Prisma
DIRECT_URL=postgresql://postgres.YOUR_PROJECT:YOUR_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# Cron job protetto (Vercel Cron)
CRON_SECRET=genera-una-stringa-casuale

# Demo: bypass login (default ON). Imposta false per riattivare auth.
DEMO_MODE=true
